{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cowork.invalid/schemas/relay/1/control",
  "$defs": {
    "protocol": { "const": "cowork.relay/1" },
    "websocketProtocol": { "const": "cowork.relay.v1" },
    "frameLimit": { "const": 65536 },
    "controlLimit": { "const": 4096 },
    "ticketSeconds": { "const": 10 },
    "id": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$" },
    "secret": { "type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" }
  },
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "protocol", "epoch", "hostId"],
      "properties": {
        "type": { "const": "ready" }, "protocol": { "$ref": "#/$defs/protocol" },
        "epoch": { "$ref": "#/$defs/id" }, "hostId": { "$ref": "#/$defs/id" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "epoch", "connectionId", "ticket", "expiresAt"],
      "properties": {
        "type": { "const": "open" }, "epoch": { "$ref": "#/$defs/id" },
        "connectionId": { "$ref": "#/$defs/id" }, "ticket": { "$ref": "#/$defs/secret" },
        "expiresAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    }
  ]
}
